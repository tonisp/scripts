strategy("Ultimate Buy/Sell Strategy v4.5 Pro", overlay=true, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, initial_capital=10000, commission_type=strategy.commission.percent,
     commission_value=0.1, slippage=1, pyramiding=0, calc_on_every_tick=true,
     max_bars_back=5000)

