useBreakEven = input.bool(true, "Use Break-Even Stop", group=grp_risk, tooltip="Moves stop loss to entry price + offset once trade reaches target ATR profit.")
beTriggerAtr = input.float(2.0, "Break-Even Trigger (ATR Mult)", minval=0.5, maxval=5.0, step=0.25, group=grp_risk, tooltip="Higher trigger = lets trade develop further before moving stop to entry.")
beOffsetAtr  = input.float(0.1, "Break-Even Profit Offset (ATR Mult)", minval=0.0, maxval=1.0, step=0.05, group=grp_risk)

