grp_risk = "═══ Risk Management & Stops ═══"
useStopLoss  = input.bool(true, "Use ATR Stop-Loss", group=grp_risk)
slAtrMult    = input.float(2.0, "Stop-Loss ATR Multiplier", minval=0.5, maxval=5.0, step=0.5, group=grp_risk, tooltip="Wider stop gives trade more room to breathe. 2.0 ATR is a solid default.")
