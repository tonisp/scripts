// ░░░░░░░░░░░░░░░░░░░░░  9. STRATEGY & BREAK-EVEN EXECUTION  ░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// Bar confirmed flag: table updates in real time on ticks, but strategy orders execute only on bar close
barConfirmed = barstate.isconfirmed or not barstate.isrealtime

atrSL = atrVal * effSlMult
atrTP = atrVal * effTpMult

var bool  buyBeTriggered = false
var bool  sellBeTriggered = false

// --- Chandelier Exit Calculation (Chuck LeBeau) ---
ceAtrVal    = ta.atr(ceAtrPeriod)
ceHigh      = ta.highest(high, ceAtrPeriod)
ceLow       = ta.lowest(low, ceAtrPeriod)
ceLongStop  = ceHigh - ceAtrVal * ceMult
ceShortStop = ceLow + ceAtrVal * ceMult

var float ceTrailingLong  = na
var float ceTrailingShort = na

// Strategy Orders (Triggered on confirmed bar close to prevent repainting execution)
if buySignal and barConfirmed and enableLong
    strategy.entry("BUY", strategy.long)

if sellSignal and barConfirmed and enableShort
    strategy.entry("SELL", strategy.short)

// Position Tracking & Risk Management using exact fill price (strategy.position_avg_price)
posAvg = strategy.position_avg_price

if strategy.position_size > 0
    if useBreakEven and not buyBeTriggered and (high >= posAvg + atrVal * effBeTrigger)
        buyBeTriggered := true
    ceTrailingLong := math.max(nz(ceTrailingLong, ceLongStop), ceLongStop)
    baseSL   = posAvg - atrSL
    beSL     = posAvg + atrVal * beOffsetAtr
    activeSL = (useBreakEven and buyBeTriggered) ? math.max(baseSL, beSL) : baseSL
    if useChandelier and not na(ceTrailingLong)
        activeSL := math.max(activeSL, ceTrailingLong)
    strategy.exit("BUY Exit", "BUY",
         stop=activeSL,
         limit=posAvg + atrTP,
         trail_points=useTrailing ? atrVal * trailAtrMult / syminfo.mintick : na,
         trail_offset=useTrailing ? atrVal * 1.0 / syminfo.mintick : na)

if strategy.position_size < 0
    if useBreakEven and not sellBeTriggered and (low <= posAvg - atrVal * effBeTrigger)
        sellBeTriggered := true
    ceTrailingShort := math.min(nz(ceTrailingShort, ceShortStop), ceShortStop)
    baseSL   = posAvg + atrSL
    beSL     = posAvg - atrVal * beOffsetAtr
    activeSL = (useBreakEven and sellBeTriggered) ? math.min(baseSL, beSL) : baseSL
    if useChandelier and not na(ceTrailingShort)
        activeSL := math.min(activeSL, ceTrailingShort)
    strategy.exit("SELL Exit", "SELL",
         stop=activeSL,
         limit=posAvg - atrTP,
         trail_points=useTrailing ? atrVal * trailAtrMult / syminfo.mintick : na,
         trail_offset=useTrailing ? atrVal * 1.0 / syminfo.mintick : na)

if strategy.position_size == 0
    buyBeTriggered  := false
    sellBeTriggered := false
    ceTrailingLong  := na
    ceTrailingShort := na

// --- Score Reversal Exit: Close when composite flips against position ---
if strategy.position_size > 0 and barConfirmed and useScoreFlipExit and compositeScore <= scoreFlipBuyThresh
    strategy.close("BUY", comment="Score Flip")
if strategy.position_size < 0 and barConfirmed and useScoreFlipExit and compositeScore >= scoreFlipSellThresh
    strategy.close("SELL", comment="Score Flip")

// --- Close on opposite signal when opposite entry is disabled ---
if strategy.position_size > 0 and barConfirmed and sellSignal and not enableShort and closeLongOnSell
    strategy.close("BUY", comment="SELL Signal Exit")
if strategy.position_size < 0 and barConfirmed and buySignal and not enableLong and closeShortOnBuy
    strategy.close("SELL", comment="BUY Signal Exit")


