// Normalize value to range [-1, 1]
normalize(float val, float minV, float maxV) =>
    math.max(-1.0, math.min(1.0, (val - (minV + maxV) / 2) / ((maxV - minV) / 2)))

// Safe number string helper (prevents NaN/crash)
safeNum(float val, string fmt) =>
    na(val) ? "N/A" : str.tostring(val, fmt)

// Auto Higher Timeframe Resolution
getHTF() =>
    if timeframe.isseconds or (timeframe.isintraday and timeframe.multiplier <= 5)
        "60"
    else if timeframe.isintraday and timeframe.multiplier <= 15
        "240"
    else if timeframe.isintraday and timeframe.multiplier <= 60
        "D"
    else if timeframe.isintraday
        "W"
    else if timeframe.isdaily
        "W"
    else if timeframe.isweekly
        "M"
    else
        "M"

htfRes = getHTF()

// Color palette function for table and visuals
scoreColor(float sc) =>
    na(sc) ? color.gray : sc >= 0.5 ? color.new(#00c853, 0) : sc >= 0.2 ? color.new(#69f0ae, 0) : sc >= -0.2 ? color.new(#ffd54f, 0) : sc >= -0.5 ? color.new(#ff8a65, 0) : color.new(#ff1744, 0)


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░  0. MARKET REGIME (CHOP INDEX)  ░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// Choppiness Index (CHOP) - detects consolidation vs trending
chopSumAtr = math.sum(ta.atr(1), chopLen)
chopHiLo   = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
chopVal    = chopHiLo > 0 ? 100 * (math.log10(chopSumAtr / chopHiLo) / math.log10(chopLen)) : 50.0
isChoppy   = useChopFilter and (chopVal >= chopThresh)


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░  1. TREND INDICATORS  ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// --- Golden & Death Cross Benchmark (TradingAgents 50 vs 200) ---
sma50       = ta.sma(close, emaMid)
sma200      = ta.sma(close, emaSlow)
goldenCross = sma50 > sma200

crossScore = 0.0
if useGoldenCross
    crossScore := goldenCross ? 0.35 : -0.35

// --- EMA ---
ema21  = ta.ema(close, emaFast)
ema50  = ta.ema(close, emaMid)
ema200 = ta.ema(close, emaSlow)

emaScore = 0.0
emaScore := close > ema200 ? emaScore + 0.30 : emaScore - 0.30
emaScore := close > ema50  ? emaScore + 0.30 : emaScore - 0.30
emaScore := ema21 > ema50  ? emaScore + 0.25 : emaScore - 0.25
if useGoldenCross
    emaScore := emaScore + crossScore * 0.15
emaScore := math.max(-1.0, math.min(1.0, emaScore))

// --- ADX / DMI ---
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
adxScore = 0.0
trendStrength = adxVal > adxThresh
adxScore := trendStrength ? (diPlus > diMinus ? 1.0 : -1.0) : 0.0

// --- Supertrend ---
[stLine, stDir] = ta.supertrend(stFactor, stPeriod)
stScore = stDir == -1 ? 1.0 : -1.0

// --- Ichimoku Cloud ---
tenkan   = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2
kijun    = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
senkouA  = (tenkan + kijun) / 2
senkouB  = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2
cloudTop = math.max(senkouA[26], senkouB[26])
cloudBot = math.min(senkouA[26], senkouB[26])

ichiScore = 0.0
ichiScore := close > cloudTop ? 0.5 : close < cloudBot ? -0.5 : 0.0
ichiScore := tenkan > kijun ? ichiScore + 0.25 : ichiScore - 0.25
ichiScore := close > tenkan ? ichiScore + 0.25 : ichiScore - 0.25
ichiScore := math.max(-1.0, math.min(1.0, ichiScore))

// --- Smart Money Concepts (SMC) Market Structure & BOS ---
var float lastSwingHigh = na
var float lastSwingLow  = na
var int   marketStructure = 0

smcPh = ta.pivothigh(high, smcLen, smcLen)
smcPl = ta.pivotlow(low, smcLen, smcLen)

if not na(smcPh)
    lastSwingHigh := smcPh
if not na(smcPl)
    lastSwingLow  := smcPl

bosBull = ta.crossover(close, lastSwingHigh)
bosBear = ta.crossunder(close, lastSwingLow)

if bosBull
    marketStructure := 1
else if bosBear
    marketStructure := -1

smcScore = 0.0
if useSMC
    if bosBull
        smcScore := 1.0
    else if bosBear
        smcScore := -1.0
    else if marketStructure == 1
        smcScore := 0.6
    else if marketStructure == -1
        smcScore := -0.6

// --- Combined Trend Score ---
trendScore = useSMC ? (emaScore * 0.25 + adxScore * 0.20 + stScore * 0.15 + ichiScore * 0.20 + smcScore * 0.20) : (emaScore * 0.30 + adxScore * 0.25 + stScore * 0.20 + ichiScore * 0.25)
trendScore := math.max(-1.0, math.min(1.0, trendScore))


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░  2. MOMENTUM & DIVERGENCE  ░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// --- RSI ---
rsiVal = ta.rsi(close, rsiLen)
rsiRising = rsiVal > rsiVal[1]
rsiFalling = rsiVal < rsiVal[1]

rsiScore = 0.0
if rsiVal < rsiOS and rsiRising
    rsiScore := 1.0
else if rsiVal < rsiOS
    rsiScore := 0.5
else if rsiVal > rsiOB and rsiFalling
    rsiScore := -1.0
else if rsiVal > rsiOB
    rsiScore := -0.5
else
    rsiScore := normalize(50 - rsiVal, -50, 50) * -1

// --- MACD ---
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)

macdScore = 0.0
macdCrossUp   = ta.crossover(macdLine, signalLine)
macdCrossDown = ta.crossunder(macdLine, signalLine)
histRising    = histLine > histLine[1]
histFalling   = histLine < histLine[1]

if macdCrossUp
    macdScore := 1.0
else if macdCrossDown
    macdScore := -1.0
else if macdLine > signalLine and histRising
    macdScore := 0.7
else if macdLine > signalLine
    macdScore := 0.3
else if macdLine < signalLine and histFalling
    macdScore := -0.7
else
    macdScore := -0.3

// Above/below zero line bonus
macdScore := macdLine > 0 ? macdScore + 0.15 : macdScore - 0.15
macdScore := math.max(-1.0, math.min(1.0, macdScore))

// --- Stochastic RSI ---
rsi1        = ta.rsi(close, stochLen)
stochK_raw  = ta.stoch(rsi1, rsi1, rsi1, stochLen)
stochK      = ta.sma(stochK_raw, stochSmK)
stochD      = ta.sma(stochK, stochSmD)

stochScore = 0.0
if stochK < 20 and stochK > stochD
    stochScore := 1.0
else if stochK < 20
    stochScore := 0.5
else if stochK > 80 and stochK < stochD
    stochScore := -1.0
else if stochK > 80
    stochScore := -0.5
else
    stochScore := stochK > stochD ? 0.3 : -0.3

// --- Divergence Engine (RSI Pivot Divergence) ---
var float prevPlPrice = na
var float prevPlRsi   = na
var int   prevPlBar   = 0

var float prevPhPrice = na
var float prevPhRsi   = na
var int   prevPhBar   = 0

bullishDiv    = false
bearishDiv    = false
hiddenBullDiv = false
hiddenBearDiv = false

pl = ta.pivotlow(low, divLeft, divRight)
if not na(pl)
    curPlPrice = pl
    curPlRsi   = rsiVal[divRight]
    if not na(prevPlPrice) and (bar_index - prevPlBar <= 60) and (bar_index - prevPlBar >= divLeft)
        if curPlPrice < prevPlPrice and curPlRsi > prevPlRsi
            bullishDiv := true
        if curPlPrice > prevPlPrice and curPlRsi < prevPlRsi
            hiddenBullDiv := true
    prevPlPrice := curPlPrice
    prevPlRsi   := curPlRsi
    prevPlBar   := bar_index - divRight

ph = ta.pivothigh(high, divLeft, divRight)
if not na(ph)
    curPhPrice = ph
    curPhRsi   = rsiVal[divRight]
    if not na(prevPhPrice) and (bar_index - prevPhBar <= 60) and (bar_index - prevPhBar >= divLeft)
        if curPhPrice > prevPhPrice and curPhRsi < prevPhRsi
            bearishDiv := true
        if curPhPrice < prevPhPrice and curPhRsi > prevPhRsi
            hiddenBearDiv := true
    prevPhPrice := curPhPrice
    prevPhRsi   := curPhRsi
    prevPhBar   := bar_index - divRight

var int lastBullDivBar = 0
var int lastBearDivBar = 0
if bullishDiv or hiddenBullDiv
    lastBullDivBar := bar_index
if bearishDiv or hiddenBearDiv
    lastBearDivBar := bar_index

bullDivActive = (bar_index - lastBullDivBar) <= 6
bearDivActive = (bar_index - lastBearDivBar) <= 6

// Divergence Score Boost (applied if feature enabled)
divScore = 0.0
if useDivFilter
    if bullDivActive
        divScore := 0.4
    else if bearDivActive
        divScore := -0.4

// --- Combined Momentum Score ---
momScore = (rsiScore * 0.30 + macdScore * 0.35 + stochScore * 0.20 + divScore * 0.15)
momScore := math.max(-1.0, math.min(1.0, momScore))


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░  3. VOLATILITY & ADAPTIVE BB  ░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// --- Bollinger Bands ---
bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = (bbUpper - bbLower) / bbBasis * 100

// --- Adaptive BB Score (Prevents Counter-trend "Walking the Bands" trap) ---
bbScore = 0.0
isStrongTrend = adxVal > adxThresh

if isStrongTrend
    // In strong trend: price riding bands is continuation, not reversal!
    if trendScore > 0.2
        bbScore := close >= bbUpper ? 0.6 : (close <= bbBasis and close >= bbLower ? 0.5 : 0.1)
    else if trendScore < -0.2
        bbScore := close <= bbLower ? -0.6 : (close >= bbBasis and close <= bbUpper ? -0.5 : -0.1)
    else
        bbScore := normalize(bbBasis - close, -(bbUpper - bbBasis), bbUpper - bbBasis) * -1
else
    // In range / mean-reversion mode: bands act as classic boundaries
    if close <= bbLower
        bbScore := 1.0
    else if close >= bbUpper
        bbScore := -1.0
    else
        bbScore := normalize(bbBasis - close, -(bbUpper - bbBasis), bbUpper - bbBasis) * -1

// --- Squeeze Momentum Indicator ---
kcMa       = ta.sma(close, kcLen)
kcRangeVal = useTrueRange ? ta.tr : (high - low)
kcRangeMa  = ta.sma(kcRangeVal, kcLen)
kcUpper    = kcMa + kcRangeMa * kcMult
kcLower    = kcMa - kcRangeMa * kcMult

sqzOn  = (bbLower > kcLower) and (bbUpper < kcUpper)
sqzOff = (bbLower < kcLower) and (bbUpper > kcUpper)
noSqz  = not sqzOn and not sqzOff

// Linear Regression Momentum
sqzVal = ta.linreg(close - math.avg(math.avg(ta.highest(high, kcLen), ta.lowest(low, kcLen)), ta.sma(close, kcLen)), kcLen, 0)
sqzValRising  = sqzVal > nz(sqzVal[1])
sqzValFalling = sqzVal < nz(sqzVal[1])

sqzBullAccel = sqzVal > 0 and sqzValRising
sqzBullDecel = sqzVal > 0 and sqzValFalling
sqzBearAccel = sqzVal < 0 and sqzValFalling
sqzBearDecel = sqzVal < 0 and sqzValRising

sqzFiredUp   = sqzOn[1] and sqzOff and sqzVal > 0
sqzFiredDown = sqzOn[1] and sqzOff and sqzVal < 0

// Squeeze Score Calculation
sqzScore = 0.0
if sqzFiredUp
    sqzScore := 1.0
else if sqzFiredDown
    sqzScore := -1.0
else if sqzBullAccel
    sqzScore := 0.75
else if sqzBullDecel
    sqzScore := 0.25
else if sqzBearAccel
    sqzScore := -0.75
else if sqzBearDecel
    sqzScore := -0.25

if sqzOn
    sqzScore := sqzScore * 0.5

// --- ATR ---
atrVal = ta.atr(atrLen)

// --- Combined Volatility Score ---
volScore = useSqueeze ? (bbScore * 0.4 + sqzScore * 0.6) : bbScore
volScore := math.max(-1.0, math.min(1.0, volScore))


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░  4. VOLUME & MONEY FLOW (TRADINGAGENTS SUITE)  ░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// --- Volume SMA ---
volSma   = ta.sma(volume, volSmaLen)
volAbove = volume > volSma
volSpike = volume > volSma * volSpikeMul

// --- OBV ---
obvVal     = ta.obv
obvEma     = ta.ema(obvVal, 21)
obvRising  = obvVal > obvEma

// --- VWAP ---
vwapVal        = ta.vwap(hlc3)
priceAboveVwap = close > vwapVal

// --- Chaikin Money Flow (CMF - math.sum extracted from ternary for compiler consistency) ---
candleRange = high - low
cmfMultiplier = candleRange != 0 ? ((close - low) - (high - close)) / candleRange : 0.0
cmfVol = cmfMultiplier * volume
sumCmfVol = math.sum(cmfVol, cmfLen)
sumVol = math.sum(volume, cmfLen)
cmfVal = sumVol != 0 ? sumCmfVol / sumVol : 0.0
cmfScore = normalize(cmfVal, -0.25, 0.25)

// --- MFI (Money Flow Index - TradingAgents) ---
mfiVal = ta.mfi(hlc3, mfiLen)
mfiScore = 0.0
if mfiVal < 20
    mfiScore := 1.0
else if mfiVal > 80
    mfiScore := -1.0
else
    mfiScore := normalize(50 - mfiVal, -50, 50) * -1

// --- VWMA vs SMA (Volume-Weighted Moving Average - TradingAgents) ---
vwmaVal = ta.vwma(close, vwmaLen)
smaBench = ta.sma(close, vwmaLen)
vwmaBull = vwmaVal > smaBench

vwmaScore = 0.0
if vwmaBull
    vwmaScore := close > vwmaVal ? 0.8 : 0.4
else
    vwmaScore := close < vwmaVal ? -0.8 : -0.4

// --- Volume Flow Indicator (VFI - Markos Katsanos) ---
vfiInter   = math.log(hlc3) - math.log(hlc3[1])
vfiVinter  = ta.stdev(vfiInter, 30)
vfiCutoff  = vfiCoef * vfiVinter * close
vfiAve     = ta.sma(volume[1], vfiLength)
vfiVmax    = vfiAve * 2.5
vfiVc      = volume < vfiVmax ? volume : vfiVmax
vfiMf      = hlc3 - hlc3[1]
vfiDir     = vfiMf > vfiCutoff ? vfiVc : vfiMf < -vfiCutoff ? -vfiVc : 0.0
vfiSum     = math.sum(vfiDir, vfiLength)
vfiVal     = vfiAve != 0 ? (vfiSum / vfiAve) / 10.0 : 0.0
vfiBull    = vfiVal > 0 and vfiVal > nz(vfiVal[1])
vfiScore   = normalize(vfiVal, -1.0, 1.0)

// --- Combined Volume Score ---
volumeScore = 0.0
if volAbove
    volumeScore := close > close[1] ? 0.20 : -0.20
else
    volumeScore := 0.0

volumeScore := obvRising ? volumeScore + 0.20 : volumeScore - 0.20
volumeScore := priceAboveVwap ? volumeScore + 0.15 : volumeScore - 0.15

if useCMF
    volumeScore := volumeScore + cmfScore * 0.15

if useMFI
    volumeScore := volumeScore + mfiScore * 0.15

if useVWMA
    volumeScore := volumeScore + vwmaScore * 0.15

if useVFI
    volumeScore := volumeScore + vfiScore * 0.15

if volSpike
    volumeScore := close > close[1] ? volumeScore + 0.10 : volumeScore - 0.10

volumeScore := math.max(-1.0, math.min(1.0, volumeScore))


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░  5. MARKET CONTEXT  ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

spxClose = request.security(spxSymbol, timeframe.period, close[1], lookahead=barmerge.lookahead_off)
spxEma50 = request.security(spxSymbol, timeframe.period, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)
spxEma21 = request.security(spxSymbol, timeframe.period, ta.ema(close, 21)[1], lookahead=barmerge.lookahead_off)
spxBullish = not na(spxClose) and not na(spxEma50) and not na(spxEma21) and (spxClose > spxEma50 and spxEma21 > spxEma50)

vixClose = request.security(vixSymbol, timeframe.period, close[1], lookahead=barmerge.lookahead_off)
vixHigh  = not na(vixClose) and (vixClose > 30)
vixLow   = not na(vixClose) and (vixClose < 20)

nasdaqClose = request.security(nasdaqSymbol, timeframe.period, close[1], lookahead=barmerge.lookahead_off)
nasdaqEma50 = request.security(nasdaqSymbol, timeframe.period, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)
nasdaqBullish = not na(nasdaqClose) and not na(nasdaqEma50) and (nasdaqClose > nasdaqEma50)

marketScore = 0.0
if useMarketCtx
    marketScore := spxBullish ? marketScore + 0.4 : marketScore - 0.4
    marketScore := vixHigh ? marketScore - 0.3 : vixLow ? marketScore + 0.3 : marketScore
    marketScore := nasdaqBullish ? marketScore + 0.3 : marketScore - 0.3
    marketScore := math.max(-1.0, math.min(1.0, marketScore))


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░  6. MULTI-TIMEFRAME (NON-REPAINTING)  ░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// Using [1] on higher timeframe data prevents lookahead bias and historical repainting
htfClose    = request.security(syminfo.tickerid, htfRes, close[1], lookahead=barmerge.lookahead_off)
htfEma21    = request.security(syminfo.tickerid, htfRes, ta.ema(close, 21)[1], lookahead=barmerge.lookahead_off)
htfEma50    = request.security(syminfo.tickerid, htfRes, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)
htfRsi      = request.security(syminfo.tickerid, htfRes, ta.rsi(close, 14)[1], lookahead=barmerge.lookahead_off)
htfMacdLine = request.security(syminfo.tickerid, htfRes, (ta.ema(close, macdFast) - ta.ema(close, macdSlow))[1], lookahead=barmerge.lookahead_off)
htfMacdSig  = request.security(syminfo.tickerid, htfRes, ta.ema(ta.ema(close, macdFast) - ta.ema(close, macdSlow), macdSignal)[1], lookahead=barmerge.lookahead_off)

mtfScore = 0.0
if useMTF
    mtfScore := not na(htfClose) and not na(htfEma50) and htfClose > htfEma50 ? mtfScore + 0.35 : mtfScore - 0.35
    mtfScore := not na(htfEma21) and not na(htfEma50) and htfEma21 > htfEma50 ? mtfScore + 0.25 : mtfScore - 0.25
    mtfScore := not na(htfRsi) and htfRsi > 50 ? mtfScore + 0.15 : mtfScore - 0.15
    mtfScore := not na(htfMacdLine) and not na(htfMacdSig) and htfMacdLine > htfMacdSig ? mtfScore + 0.25 : mtfScore - 0.25
    mtfScore := math.max(-1.0, math.min(1.0, mtfScore))


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░  7. COMPOSITE SCORE  ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

totalWeight = wTrend + wMom + wVol + wVolume + (useMarketCtx ? wMarket : 0) + (useMTF ? wMTF : 0)

compositeScore = (trendScore * wTrend +
                  momScore * wMom +
                  volScore * wVol +
                  volumeScore * wVolume +
                  (useMarketCtx ? marketScore * wMarket : 0) +
                  (useMTF ? mtfScore * wMTF : 0)) / totalWeight

compositeScore := math.max(-1.0, math.min(1.0, compositeScore))

// Plot composite score invisibly so it is accessible as plot_0 in alerts
plot(compositeScore, "Composite Score Value", display=display.none)


// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░  8. PRICE ACTION & SIGNAL FILTERS  ░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// Cooldown mechanism
var int lastSignalBar = 0
barsSinceSignal = bar_index - lastSignalBar

// Candlestick Confirmation
cUpperWick = high - math.max(open, close)
cLowerWick = math.min(open, close) - low
paConfirmBuy  = not useCandleFilter or (close >= open and close >= (high + low) * 0.48 and (candleRange == 0 or cUpperWick <= candleRange * 0.45))
paConfirmSell = not useCandleFilter or (close <= open and close <= (high + low) * 0.52 and (candleRange == 0 or cLowerWick <= candleRange * 0.45))

// Session Filter
inSession = not useSessionFilter or not na(time(timeframe.period, sessTime))

// --- Timeframe Auto-Adaptation Logic ---
tfInMinutes = timeframe.isseconds ? (timeframe.multiplier / 60.0) : timeframe.isminutes ? (timeframe.multiplier * 1.0) : timeframe.isdaily ? 1440.0 : timeframe.isweekly ? 10080.0 : timeframe.ismonthly ? 43200.0 : 60.0

is1m     = tfInMinutes <= 1.0
is5m     = tfInMinutes > 1.0 and tfInMinutes <= 5.0
is15m    = tfInMinutes > 5.0 and tfInMinutes <= 15.0
is30m    = tfInMinutes > 15.0 and tfInMinutes <= 30.0
is1hPlus = tfInMinutes > 30.0

tfProfileName = is1m ? "⚠ SCALP (1m)" : is5m ? "SCALP (5m)" : is15m ? "SWING (15m)" : is30m ? "SWING (30m)" : "TREND (1h+)"

// ═══════════════════════════════════════════════════════════════════
// Dynamic parameters PROVEN PROFITABLE through SPY grid search
// ═══════════════════════════════════════════════════════════════════

// Signal & Filter Adaptation
effEarlyReversal = useAutoAdaptiveTF ? is1hPlus : useEarlyReversal
effRequireEma200 = useAutoAdaptiveTF ? (is5m or is15m) : requireEma200
effRequireVol    = useAutoAdaptiveTF ? (is15m or is1hPlus) : requireVolAbove
effRequireBOS    = useAutoAdaptiveTF ? false : requireBullStructure
effBlockHistDrop = useAutoAdaptiveTF ? false : blockOnHistDrop

// Threshold Adaptation (per-TF optimized)
effBuyThresh     = useAutoAdaptiveTF ? (is1m ? 0.40 : is5m ? 0.50 : is15m ? 0.40 : is30m ? 0.30 : 0.50) : buyThreshold
effSellThresh    = useAutoAdaptiveTF ? (is1m ? -0.40 : is5m ? -0.50 : is15m ? -0.40 : is30m ? -0.30 : -0.50) : sellThreshold
effEarlyThresh   = useAutoAdaptiveTF ? 0.15 : earlyBuyThresh

// Cooldown Adaptation
effCooldown      = useAutoAdaptiveTF ? (is1hPlus ? 5 : is15m ? 3 : 5) : cooldownBars

// Chop Threshold Adaptation
effChopThresh    = useAutoAdaptiveTF ? (is15m ? 58.0 : is1hPlus ? 58.0 : 60.0) : chopThresh

// Risk Management Adaptation (SL/TP/BE — proven profitable per TF)
effSlMult    = useAutoAdaptiveTF ? (is1m ? 2.5 : is5m ? 1.5 : is15m ? 2.5 : is30m ? 2.5 : 1.5) : slAtrMult
effTpMult    = useAutoAdaptiveTF ? (is1m ? 3.0 : is5m ? 2.5 : is15m ? 2.5 : is30m ? 1.5 : 3.0) : tpAtrMult
effBeTrigger = useAutoAdaptiveTF ? (is15m ? 2.0 : is1hPlus ? 1.5 : 99.0) : beTriggerAtr
// Note: effBeTrigger=99.0 for 5m/30m effectively disables Break-Even (proven harmful on fast TFs)

// Core filters
volumeConfirm      = not effRequireVol or volAbove
notContradictBuy   = not (trendScore < -0.5 and momScore < -0.5)
notContradictSell  = not (trendScore > 0.5 and momScore > 0.5)
regimeAllowed      = not (useChopFilter and chopVal >= effChopThresh)
ema200ConfirmBuy   = not effRequireEma200 or close > ema200
ema200ConfirmSell  = not effRequireEma200 or close < ema200
rsiFilterBuy       = not useRsiFilter or rsiVal <= rsiMaxBuyLevel
rsiFilterSell      = not useRsiFilter or rsiVal >= rsiMinSellLevel
macdHistDropBuy    = effBlockHistDrop and macdLine > 0 and histLine < histLine[1] and histLine[1] < histLine[2]
macdOverextendedBuy = macdLine > atrVal * macdMaxAtrMult
macdFilterBuy      = not useMacdFilter or not (macdHistDropBuy or macdOverextendedBuy)
macdHistRiseSell   = effBlockHistDrop and macdLine < 0 and histLine > histLine[1] and histLine[1] > histLine[2]
macdOverextendedSell = macdLine < -atrVal * macdMaxAtrMult
macdFilterSell     = not useMacdFilter or not (macdHistRiseSell or macdOverextendedSell)
smcFilterBuy       = not effRequireBOS or marketStructure >= 0
smcFilterSell      = not effRequireBOS or marketStructure <= 0

// --- Standard Trend-Following Signals (Ideal for 30m / 1h) ---
standardBuy  = compositeScore >= effBuyThresh and barsSinceSignal >= effCooldown and volumeConfirm and notContradictBuy and regimeAllowed and paConfirmBuy and inSession and ema200ConfirmBuy and rsiFilterBuy and macdFilterBuy and smcFilterBuy
standardSell = compositeScore <= effSellThresh and barsSinceSignal >= effCooldown and volumeConfirm and notContradictSell and regimeAllowed and paConfirmSell and inSession and ema200ConfirmSell and rsiFilterSell and macdFilterSell and smcFilterSell

// Pre-calculate stateful functions to prevent execution warnings
crossEma21Up   = ta.crossover(close, ema21)
crossEma21Down = ta.crossunder(close, ema21)
crossOpenUp    = ta.crossover(close, open)
crossOpenDown  = ta.crossunder(close, open)
crossStochUp   = ta.crossover(stochK, stochD)
crossStochDown = ta.crossunder(stochK, stochD)

// --- Early Reversal Signals (Point 2 B - Ideal for 1m / 5m / 15m Scalping) ---
earlyDivTriggerBuy    = useDivTrigger and (bullishDiv or (bullDivActive and crossEma21Up))
earlySqzTriggerBuy    = useSqzFireTrigger and (sqzFiredUp or (sqzBearDecel and crossOpenUp))
earlyStochTriggerBuy  = useStochTrigger and (crossStochUp and stochK < 40)
earlyBuyCondition     = earlyDivTriggerBuy or earlySqzTriggerBuy or earlyStochTriggerBuy
earlyBuySafety        = (not requireEma50Early or close > ema50) and regimeAllowed and notContradictBuy and inSession and (close >= open or close > close[1]) and rsiFilterBuy
earlyBuySignal        = effEarlyReversal and earlyBuyCondition and earlyBuySafety and compositeScore >= effEarlyThresh and barsSinceSignal >= effCooldown

earlyDivTriggerSell   = useDivTrigger and (bearishDiv or (bearDivActive and crossEma21Down))
earlySqzTriggerSell   = useSqzFireTrigger and (sqzFiredDown or (sqzBullDecel and crossOpenDown))
earlyStochTriggerSell = useStochTrigger and (crossStochDown and stochK > 60)
earlySellCondition    = earlyDivTriggerSell or earlySqzTriggerSell or earlyStochTriggerSell
earlySellSafety       = (not requireEma50Early or close < ema50) and regimeAllowed and notContradictSell and inSession and (close <= open or close < close[1]) and rsiFilterSell
earlySellSignal       = effEarlyReversal and earlySellCondition and earlySellSafety and compositeScore <= -effEarlyThresh and barsSinceSignal >= effCooldown

// **** COMBINED FINAL SIGNALS ****
buySignal       = standardBuy or earlyBuySignal
sellSignal      = standardSell or earlySellSignal

isEarlyOnlyBuy  = earlyBuySignal and not standardBuy
isEarlyOnlySell = earlySellSignal and not standardSell

