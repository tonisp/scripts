// ░░░░░░░░░░░░░░░░░░░░░  11. PERSISTENT INFORMATION TABLE  ░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// Resolve table position based on user settings (single line to avoid line continuation parser error)
tablePos = tablePosOpt == "Bottom Right" ? position.bottom_right : tablePosOpt == "Top Left" ? position.top_left : tablePosOpt == "Bottom Left" ? position.bottom_left : position.top_right

// Resolve table text size based on user settings (single line to avoid line continuation parser error)
tableSize = tableSizeOpt == "Tiny" ? size.tiny : tableSizeOpt == "Normal" ? size.normal : size.small

// Slightly larger, prominent font size for the COMPOSITE header & score
compSize = tableSize == size.tiny ? size.small : size.normal

var table infoTable = table.new(tablePos, 2, 20,
     bgcolor=color.new(#1e1e1e, 5),
     border_color=color.new(#333333, 0),
     border_width=1,
     frame_color=color.new(#333333, 0),
     frame_width=2)

// Table renders on both the final confirmed bar and live ticking bars
if showTable and (barstate.islast or barstate.islastconfirmedhistory)
    headerBg = color.new(#0d47a1, 0)
    headerFg = color.white

    table.cell(infoTable, 0, 0, "INDICATOR (AI SUITE)", text_color=headerFg, bgcolor=headerBg, text_size=tableSize)
    table.cell(infoTable, 1, 0, "SCORE / STATUS", text_color=headerFg, bgcolor=headerBg, text_size=tableSize)

    table.cell(infoTable, 0, 1, "EMA & 50/200 Cross", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 1, safeNum(emaScore, "#.##") + (goldenCross ? " (GOLD)" : " (DEATH)"), text_color=scoreColor(emaScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 2, "ADX / DMI", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 2, safeNum(adxScore, "#.##"), text_color=scoreColor(adxScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 3, "Supertrend", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 3, safeNum(stScore, "#.##"), text_color=scoreColor(stScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 4, "Ichimoku", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 4, safeNum(ichiScore, "#.##"), text_color=scoreColor(ichiScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 5, "RSI (14)", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 5, safeNum(rsiScore, "#.##") + " (" + safeNum(rsiVal, "#.#") + ")", text_color=scoreColor(rsiScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 6, "MACD (Line/Sig/Hist)", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 6, safeNum(macdScore, "#.##"), text_color=scoreColor(macdScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 7, "StochRSI", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 7, safeNum(stochScore, "#.##"), text_color=scoreColor(stochScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 8, "Bollinger (Adapt)", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 8, safeNum(bbScore, "#.##"), text_color=scoreColor(bbScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 9, "Volume & OBV", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 9, safeNum(volumeScore, "#.##"), text_color=scoreColor(volumeScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    // TradingAgents specific indicators
    mfiStatusText = safeNum(mfiScore, "#.##") + " (" + safeNum(mfiVal, "#.#") + ")"
    table.cell(infoTable, 0, 10, "MFI (Money Flow)", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 10, mfiStatusText, text_color=scoreColor(mfiScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    vwmaStatusText = vwmaBull ? "BULL (VWMA>SMA)" : "BEAR (VWMA<SMA)"
    vwmaStatusCol  = vwmaBull ? color.new(#00e676, 0) : color.new(#ff5252, 0)
    table.cell(infoTable, 0, 11, "VWMA Volume Trend", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 11, vwmaStatusText, text_color=vwmaStatusCol, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    table.cell(infoTable, 0, 12, "CMF Flow", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 12, safeNum(cmfVal, "#.###"), text_color=scoreColor(cmfScore), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    mktSc = useMarketCtx ? marketScore : 0.0
    table.cell(infoTable, 0, 13, "Market Ctx", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 13, safeNum(mktSc, "#.##"), text_color=scoreColor(mktSc), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    mtfSc = useMTF ? mtfScore : 0.0
    table.cell(infoTable, 0, 14, "Multi-TF", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 14, safeNum(mtfSc, "#.##"), text_color=scoreColor(mtfSc), bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    // Regime & Filter Statuses
    chopStatusText = isChoppy ? "CHOPPY (" + safeNum(chopVal, "#.#") + ")" : "TREND (" + safeNum(chopVal, "#.#") + ")"
    chopStatusCol  = isChoppy ? color.new(#ff5252, 0) : color.new(#00e676, 0)
    table.cell(infoTable, 0, 15, "Regime / CHOP", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 15, chopStatusText, text_color=chopStatusCol, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    divStatusText = bullDivActive ? "BULL DIV" : bearDivActive ? "BEAR DIV" : "NONE"
    divStatusCol  = bullDivActive ? color.new(#00e676, 0) : bearDivActive ? color.new(#ff5252, 0) : color.gray
    table.cell(infoTable, 0, 16, "Divergence", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 16, divStatusText, text_color=divStatusCol, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    paStatusText = paConfirmBuy and paConfirmSell ? "BALANCED" : paConfirmBuy ? "BULL CLOSE" : paConfirmSell ? "BEAR CLOSE" : "NEUTRAL"
    table.cell(infoTable, 0, 17, "Price Action", text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 17, paStatusText, text_color=color.white, bgcolor=color.new(#2d2d2d, 0), text_size=tableSize)

    // Separator
    table.cell(infoTable, 0, 18, "----------", text_color=color.gray, bgcolor=color.new(#1e1e1e, 0), text_size=tableSize)
    table.cell(infoTable, 1, 18, "------", text_color=color.gray, bgcolor=color.new(#1e1e1e, 0), text_size=tableSize)

    // Composite - Bold contrast with black text on bright green, red, or yellow background
    compBg = compositeScore >= buyThreshold ? color.new(#00c853, 0) : compositeScore <= sellThreshold ? color.new(#ff1744, 0) : color.new(#ffd54f, 0)
    table.cell(infoTable, 0, 19, "COMPOSITE", text_color=color.black, bgcolor=compBg, text_size=compSize, text_halign=text.align_left)
    table.cell(infoTable, 1, 19, safeNum(compositeScore, "#.###"), text_color=color.black, bgcolor=compBg, text_size=compSize)


