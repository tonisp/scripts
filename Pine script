// --- Signal Thresholds ---
grp_sig = "═══ Signal Settings ═══"
buyThreshold  = input.float(0.40, "Buy Threshold (Composite Score)", minval=0.1, maxval=1.0, step=0.05, group=grp_sig, tooltip="Minimum composite score to trigger a BUY signal. Higher = fewer but more reliable signals.")
sellThreshold = input.float(-0.40, "Sell Threshold (Composite Score)", minval=-1.0, maxval=-0.1, step=0.05, group=grp_sig, tooltip="Maximum composite score to trigger a SELL signal. Lower = fewer but more reliable signals.")
